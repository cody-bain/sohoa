---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="That page could not be found." hidePageNav>
  <div class="prose">
    <p>Sorry, we could not find that page. It may have moved when the site was rebuilt.</p>
    <p>
      Try the <a href="/search">search page</a>, the <a href="/keyword-index">keyword index</a>, or
      start again from the <a href="/">home page</a>.
    </p>
  </div>
</BaseLayout>
